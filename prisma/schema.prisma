generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIOS Y PERMISOS ────────────────────────────────

model Usuario {
  id        String   @id @default(cuid())
  nombre    String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  roles        UsuarioRol[]
  conductor    Conductor?
  estadoOrden  EstadoOrden[]

  @@map("usuarios")
}

model Rol {
  id          String  @id @default(cuid())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  // Relaciones
  usuarios  UsuarioRol[]
  permisos  PermisoRol[]

  @@map("roles")
}

model UsuarioRol {
  id        String @id @default(cuid())
  usuarioId String @map("usuario_id")
  rolId     String @map("rol_id")

  // Relaciones
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@map("usuario_roles")
}

model PermisoRol {
  id           String  @id @default(cuid())
  rolId        String  @map("rol_id")
  modulo       String  @db.VarChar(50)
  puedeVer     Boolean @default(false) @map("puede_ver")
  puedeCrear   Boolean @default(false) @map("puede_crear")
  puedeEditar  Boolean @default(false) @map("puede_editar")
  puedeEliminar Boolean @default(false) @map("puede_eliminar")

  // Relaciones
  rol Rol @relation(fields: [rolId], references: [id])

  @@map("permiso_roles")
}

// ─── OPERACIONES ────────────────────────────────────────

model Cliente {
  id        String   @id @default(cuid())
  empresa   String   @db.VarChar(150)
  rnc       String   @unique @db.VarChar(20)
  ciudad    String   @db.VarChar(80)
  direccion String?  @db.VarChar(255)
  telefono  String?  @db.VarChar(20)
  email     String?  @db.VarChar(150)
  contacto  String?  @db.VarChar(100)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  ordenes   Orden[]
  facturas  Factura[]

  @@map("clientes")
}

model Conductor {
  id             String  @id @default(cuid())
  usuarioId      String  @unique @map("usuario_id")
  nombre         String  @db.VarChar(100)
  cedula         String  @unique @db.VarChar(20)
  telefono       String? @db.VarChar(20)
  licenciaNum    String  @db.VarChar(30) @map("licencia_num")
  licenciaCat    String  @db.VarChar(10) @map("licencia_cat")
  licenciaVence  DateTime @map("licencia_vence") @db.Date
  activo         Boolean @default(true)

  // Relaciones
  usuario    Usuario     @relation(fields: [usuarioId], references: [id])
  viajes     Viaje[]
  incidentes Incidente[]

  @@map("conductores")
}

model Vehiculo {
  id           String    @id @default(cuid())
  placa        String    @unique @db.VarChar(20)
  tipo         String    @db.VarChar(50)
  capacidadKg  Decimal   @db.Decimal(10, 2) @map("capacidad_kg")
  capacidadM3  Decimal   @db.Decimal(10, 2) @map("capacidad_m3")
  anio         Int       @db.SmallInt
  estado       String    @db.VarChar(20)
  lat          Decimal?  @db.Decimal(10, 6)
  lng          Decimal?  @db.Decimal(10, 6)
  ubicacionAt  DateTime? @map("ubicacion_at")

  // Relaciones
  viajes      Viaje[]
  ubicaciones UbicacionVehiculo[]

  @@map("vehiculos")
}

model Viaje {
  id           String    @id @default(cuid())
  vehiculoId   String    @map("vehiculo_id")
  conductorId  String    @map("conductor_id")
  estado       String    @db.VarChar(20)
  fechaSalida  DateTime? @map("fecha_salida")
  fechaLlegada DateTime? @map("fecha_llegada")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relaciones
  vehiculo  Vehiculo @relation(fields: [vehiculoId], references: [id])
  conductor Conductor @relation(fields: [conductorId], references: [id])
  ordenes   Orden[]

  @@map("viajes")
}

model Orden {
  id            String    @id @default(cuid())
  codigo        String    @unique @db.VarChar(20)
  clienteId     String    @map("cliente_id")
  viajeId       String?   @map("viaje_id")
  origen        String    @db.VarChar(255)
  destino       String    @db.VarChar(255)
  pesoKg        Decimal   @db.Decimal(10, 2) @map("peso_kg")
  volumenM3     Decimal?  @db.Decimal(10, 2) @map("volumen_m3")
  descripcion   String    @db.VarChar(500)
  instrucciones String?   @db.VarChar(500)
  estado        String    @default("PENDING") @db.VarChar(20)
  fechaEstimada DateTime  @map("fecha_estimada") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relaciones
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  viaje          Viaje?         @relation(fields: [viajeId], references: [id])
  detalles       DetalleOrden[]
  historial      EstadoOrden[]
  incidentes     Incidente[]
  detalleFactura DetalleFactura[]

  @@map("ordenes")
}

model DetalleOrden {
  id          String   @id @default(cuid())
  ordenId     String   @map("orden_id")
  descripcion String   @db.VarChar(255)
  cantidad    Int
  pesoKg      Decimal  @db.Decimal(10, 2) @map("peso_kg")
  volumenM3   Decimal? @db.Decimal(10, 2) @map("volumen_m3")

  // Relaciones
  orden Orden @relation(fields: [ordenId], references: [id])

  @@map("detalle_ordenes")
}

model EstadoOrden {
  id             String   @id @default(cuid())
  ordenId        String   @map("orden_id")
  usuarioId      String   @map("usuario_id")
  estadoAnterior String?  @db.VarChar(20) @map("estado_anterior")
  estadoNuevo    String   @db.VarChar(20) @map("estado_nuevo")
  nota           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relaciones
  orden   Orden   @relation(fields: [ordenId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("estado_ordenes")
}

model Incidente {
  id          String   @id @default(cuid())
  ordenId     String   @map("orden_id")
  conductorId String   @map("conductor_id")
  tipo        String   @db.VarChar(50)
  severidad   String   @db.VarChar(20)
  descripcion String   @db.VarChar(500)
  resuelto    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  orden     Orden     @relation(fields: [ordenId], references: [id])
  conductor Conductor @relation(fields: [conductorId], references: [id])

  @@map("incidentes")
}

// ─── TRACKING Y FACTURACIÓN ─────────────────────────────

model UbicacionVehiculo {
  id          String   @id @default(cuid())
  vehiculoId  String   @map("vehiculo_id")
  lat         Decimal  @db.Decimal(10, 6)
  lng         Decimal  @db.Decimal(10, 6)
  recordedAt  DateTime @default(now()) @map("recorded_at")

  // Relaciones
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@map("ubicaciones_vehiculo")
}

model Factura {
  id               String   @id @default(cuid())
  codigo           String   @unique @db.VarChar(20)
  clienteId        String   @map("cliente_id")
  estado           String   @db.VarChar(20)
  montoTotal       Decimal  @db.Decimal(12, 2) @map("monto_total")
  fechaEmision     DateTime @map("fecha_emision") @db.Date
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date
  createdAt        DateTime @default(now()) @map("created_at")

  // Relaciones
  cliente  Cliente          @relation(fields: [clienteId], references: [id])
  detalles DetalleFactura[]

  @@map("facturas")
}

model DetalleFactura {
  id          String  @id @default(cuid())
  facturaId   String  @map("factura_id")
  ordenId     String  @map("orden_id")
  descripcion String  @db.VarChar(255)
  cantidad    Decimal @db.Decimal(10, 2)
  precioUnit  Decimal @db.Decimal(12, 2) @map("precio_unit")
  subtotal    Decimal @db.Decimal(12, 2)

  // Relaciones
  factura Factura @relation(fields: [facturaId], references: [id])
  orden   Orden   @relation(fields: [ordenId], references: [id])

  @@map("detalle_facturas")
}